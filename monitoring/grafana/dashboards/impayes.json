{
    "__inputs": [],
    "__requires": [
        {
            "type": "grafana",
            "id": "grafana",
            "name": "Grafana",
            "version": "10.0.0"
        },
        {
            "type": "datasource",
            "id": "prometheus",
            "name": "Prometheus",
            "version": "1.0.0"
        }
    ],
    "annotations": {
        "list": []
    },
    "description": "Dashboard de synchronisation des impayés — Vue instantanée",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [],
    "panels": [
        {
            "id": 1,
            "type": "stat",
            "title": "Cycles réussis",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 8,
                "h": 4
            },
            "options": {
                "colorMode": "background",
                "justifyMode": "center",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                }
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "short",
                    "noValue": "0"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "sum(impayes_sync_cycles_total{status=\"success\"}) or vector(0)",
                    "legendFormat": "Succès"
                }
            ]
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Cycles en échec",
            "gridPos": {
                "x": 8,
                "y": 0,
                "w": 8,
                "h": 4
            },
            "options": {
                "colorMode": "background",
                "justifyMode": "center",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                }
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 1
                            }
                        ]
                    },
                    "unit": "short",
                    "noValue": "0"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "sum(impayes_sync_cycles_total{status=\"failure\"}) or vector(0)",
                    "legendFormat": "Échecs"
                }
            ]
        },
        {
            "id": 3,
            "type": "stat",
            "title": "Date de démarrage de la dernière synchronisation",
            "gridPos": {
                "x": 16,
                "y": 0,
                "w": 8,
                "h": 4
            },
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "reduceOptions": {
                    "calcs": [
                        "last"
                    ]
                },
                "textMode": "value"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            }
                        ]
                    },
                    "unit": "dateTimeAsIso",
                    "noValue": "Aucune (en attente)"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "impayes_sync_last_success_timestamp * 1000"
                }
            ]
        },
        {
            "id": 4,
            "type": "timeseries",
            "title": "Évolution de la durée des cycles",
            "description": "Durée chronométrée pour le processus (Le pic retombe en 0s à la fin d'opération en attendant la prochaine)",
            "gridPos": {
                "x": 0,
                "y": 4,
                "w": 24,
                "h": 8
            },
            "options": {
                "tooltip": {
                    "mode": "single",
                    "sort": "none"
                },
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": false
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "stepAfter",
                        "fillOpacity": 15,
                        "lineWidth": 2,
                        "showPoints": "always",
                        "pointSize": 5,
                        "spanNulls": false
                    },
                    "min": 0
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "impayes_sync_cycle_last_duration_seconds",
                    "format": "time_series",
                    "legendFormat": "Durée Exécution"
                }
            ]
        },
        {
            "id": 5,
            "type": "bargauge",
            "title": "Lignes extraites au dernier cycle",
            "description": "1 barre par schéma",
            "gridPos": {
                "x": 0,
                "y": 12,
                "w": 8,
                "h": 8
            },
            "options": {
                "displayMode": "gradient",
                "orientation": "horizontal",
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "showUnfilled": true
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "noValue": "0"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "impayes_extraction_last_rows",
                    "legendFormat": "{{schema}}",
                    "format": "time_series",
                    "instant": true
                }
            ]
        },
        {
            "id": 6,
            "type": "bargauge",
            "title": "Lignes centralisées au dernier cycle",
            "description": "4 opérations fixes CRM",
            "gridPos": {
                "x": 8,
                "y": 12,
                "w": 8,
                "h": 8
            },
            "options": {
                "displayMode": "gradient",
                "orientation": "horizontal",
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "showUnfilled": true
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "noValue": "0"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "impayes_centralization_last_rows",
                    "legendFormat": "{{operation}}",
                    "format": "time_series",
                    "instant": true
                }
            ]
        },
        {
            "id": 7,
            "type": "bargauge",
            "title": "Lignes dispatchées au dernier cycle",
            "description": "4 schémas locaux",
            "gridPos": {
                "x": 16,
                "y": 12,
                "w": 8,
                "h": 8
            },
            "options": {
                "displayMode": "gradient",
                "orientation": "horizontal",
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "showUnfilled": true
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "noValue": "0"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "impayes_dispatch_last_rows",
                    "legendFormat": "{{schema}}",
                    "format": "time_series",
                    "instant": true
                }
            ]
        }
    ],
    "refresh": "10s",
    "schemaVersion": 38,
    "tags": [
        "impayes",
        "synchronisation",
        "oracle"
    ],
    "time": {
        "from": "now-2h",
        "to": "now"
    },
    "timepicker": {},
    "title": "Impayes — Synchronisation",
    "uid": "impayes-sync-001",
    "version": 6
}