# Timeout par table en secondes (defaut : 300s = 5 minutes)
# Si une table depasse ce delai, elle est marquee en echec et on passe a la suivante
TABLE_TIMEOUT_SEC=300

# Timeouts et retry des connexions Oracle
DB_CONNECT_TIMEOUT=30
DB_CALL_TIMEOUT_MS=600000
DB_MAX_RETRIES=3
DB_RETRY_DELAY_SEC=5

